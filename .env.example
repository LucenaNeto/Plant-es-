# Conexao usada pela aplicacao.
#
# `connection_limit=1` NAO e opcional aqui, e a falta dele ja causou incidente.
# O padrao do Prisma e (nucleos x 2 + 1) conexoes por processo -- numa maquina
# de 8 nucleos, 17. O pooler do Supabase no plano atual aceita 15 no total, em
# session mode (porta 5432), onde cada conexao fica presa a vida inteira do
# processo. Resultado: um unico `npm run dev` esgota o pool e o banco passa a
# responder FATAL (EMAXCONNSESSION) para todo mundo, producao inclusive.
#
# Com o limite em 1, cada processo (dev local ou instancia serverless na
# Vercel) segura exatamente uma conexao.
#
# Sobre a porta: 6543 e o transaction mode, que escala melhor porque devolve a
# conexao ao pool a cada transacao. Medimos, porem, ~700ms por consulta contra
# ~124ms na 5432 -- transaction mode faz mais idas e voltas, e com o banco em
# ca-central-1 (Canada) cada ida custa caro. A troca so compensa depois de
# migrar o banco para sa-east-1 (Sao Paulo).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?connection_limit=1"

# Mesma conexao, sem o connection_limit da aplicacao. O Prisma usa esta para
# migrations, que precisam de sessao dedicada para rodar DDL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

AUTH_SECRET="replace-with-a-secure-random-secret"
AUTH_TRUST_HOST=true

# Opcional: limite em ms acima do qual uma consulta vira log de alerta.
# Padrao 500. Valor invalido cai no padrao e emite config.invalid_slow_query_ms.
# SLOW_QUERY_MS=500
